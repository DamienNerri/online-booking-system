# Variables d'environnement — copier en .env (utilisées par docker compose)
ASPNETCORE_ENVIRONMENT=Development

# Base de données PostgreSQL (source de vérité + coordination concurrence)
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking
ConnectionStrings__Default=Host=postgres;Port=5432;Database=booking;Username=booking;Password=booking

# Sécurité (JWT)
Jwt__Secret=change-me-in-production-please-use-a-long-random-value
Jwt__Issuer=online-booking-system
Jwt__ExpiresMinutes=60

# Réservation
Booking__HoldTtlSeconds=300

# Rate limiting
RateLimit__WindowSeconds=60
RateLimit__MaxRequests=100
