# ============================================================
# Configuration production — copier en .env.production
# Ne jamais committer ce fichier avec de vraies valeurs.
# ============================================================

# Base de données
DB_HOST=<rds-endpoint-ou-ip-serveur>
DB_PORT=5432
DB_NAME=onlinebooking
DB_USER=booking_user
DB_PASSWORD=<mot-de-passe-fort>
ConnectionStrings__Default=Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD};Pooling=true;Maximum Pool Size=20

# JWT — générer avec : openssl rand -base64 64
Jwt__Secret=<secret-minimum-32-caracteres>
Jwt__Issuer=https://votre-domaine.com
Jwt__ExpiresMinutes=60

# Réservation
Booking__HoldTtlSeconds=300

# Rate limiting
RateLimit__MaxRequestsPerWindow=100
RateLimit__WindowSeconds=60

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Port exposé par Nginx (docker-compose.aws.yml)
EXTERNAL_PORT=80
